# Test-specific Dockerfile that includes test dependencies
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install both runtime and test dependencies
COPY requirements.txt requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-test.txt

# No source copy: docker-test.sh bind-mounts the backend over /app (and a
# fresh tmpfs over /app/data), so the image only carries the dependencies.
ENV PYTHONPATH=/app
